# ── Server ──
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# Comma-separated browser origins allowed to call the API.
# Development: defaults to http://localhost:3000. PRODUCTION: required, exact origins only, https (no *, no paths, no trailing slash).
CORS_ORIGINS=http://localhost:3000

# ── AWS RDS PostgreSQL (database name: payantra) ──
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-INSTANCE.xxxxxx.ap-south-1.rds.amazonaws.com:5432/payantra
# RDS requires TLS. Set true for any non-local database.
# Production refuses to boot with false unless the database host is loopback.
DATABASE_SSL=true
# Connections in the Prisma pool (default 10). Set to 1 ONLY when using the local PGlite dev database.
DATABASE_POOL_MAX=10
# The AWS RDS CA bundle. DATABASE_SSL=true verifies the server certificate, and without the bundle every query fails
# with "self-signed certificate in certificate chain". The bundle ships in this repo; point at it (a relative path is
# resolved from the server/ folder, so this works from any working directory):
DATABASE_SSL_CA_FILE=./certs/global-bundle.pem
# ...or paste the PEM instead, newlines written as \n. Set one of the two, never both.
# DATABASE_SSL_CA=

# ── Supabase Auth ──
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Only for legacy projects that still sign tokens with a shared secret (HS256). Leave empty otherwise.
SUPABASE_JWT_SECRET=

# ── Razorpay (use rzp_test_* keys until go-live) ──
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Only for tests/demos: point at a Razorpay stand-in. Leave unset to use the real API.
# RAZORPAY_API_BASE=https://api.razorpay.com/v1

# ── Operations ──
# Requests per minute per IP (all routes), and per 15 minutes on sensitive writes (checkout, coupons, refunds…)
RATE_LIMIT_MAX=300
RATE_LIMIT_SENSITIVE_MAX=30
# How often the server looks for unpaid online orders whose stock reservation has run out (0 = never)
ORDER_EXPIRY_SWEEP_SECONDS=60

# ── Delivery verification ──
# Secret behind the 6-digit delivery code the customer reads out at the door. Codes are DERIVED from it (never stored),
# so it must be long and random, and the same on every API instance. REQUIRED in production (32+ characters).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DELIVERY_OTP_SECRET=

# ── Production operations (all optional) ──
# Proxies between the internet and this process: ALB = 1, CloudFront + ALB = 2. Wrong values break per-IP rate limiting.
TRUST_PROXY_HOPS=1
# On SIGTERM: seconds to keep serving while /health/ready already answers 503 (let the load balancer notice), then the
# hard limit for in-flight requests to finish. Keep the drain shorter than your orchestrator's stop timeout.
SHUTDOWN_DRAIN_SECONDS=5
SHUTDOWN_TIMEOUT_SECONDS=25
# Build identifier (git SHA). Shown by /health, tagged on every log line and every error report.
RELEASE=
# Error reporting to Sentry (or a Sentry-compatible endpoint). Empty = errors go to the JSON log only.
SENTRY_DSN=
# Enables GET /api/v1/health/metrics (Prometheus text format) for callers sending "Authorization: Bearer <token>".
# 24+ random characters. Empty = the endpoint does not exist.
METRICS_TOKEN=
