# ── Server ──
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# Comma-separated browser origins allowed to call the API
CORS_ORIGINS=http://localhost:3000

# ── AWS RDS PostgreSQL (database name: payantra) ──
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-INSTANCE.xxxxxx.ap-south-1.rds.amazonaws.com:5432/payantra
# RDS requires TLS. Set true for any non-local database.
DATABASE_SSL=true
# Connections in the Prisma pool (default 10). Set to 1 ONLY when using the local PGlite dev database.
DATABASE_POOL_MAX=10
# PEM of the AWS RDS CA bundle (https://truststore.pki.rds.amazonaws.com/), newlines as \n
DATABASE_SSL_CA=

# ── Supabase Auth ──
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Only for legacy projects that still sign tokens with a shared secret (HS256). Leave empty otherwise.
SUPABASE_JWT_SECRET=

# ── Razorpay (use rzp_test_* keys until go-live) ──
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Only for tests/demos: point at a Razorpay stand-in. Leave unset to use the real API.
# RAZORPAY_API_BASE=https://api.razorpay.com/v1

# ── Operations ──
# Requests per minute per IP (all routes), and per 15 minutes on sensitive writes (checkout, coupons, refunds…)
RATE_LIMIT_MAX=300
RATE_LIMIT_SENSITIVE_MAX=30
# How often the server looks for unpaid online orders whose stock reservation has run out (0 = never)
ORDER_EXPIRY_SWEEP_SECONDS=60

# ── Delivery verification ──
# Secret behind the 6-digit delivery code the customer reads out at the door. Codes are DERIVED from it (never stored),
# so it must be long and random, and the same on every API instance. REQUIRED in production (32+ characters).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DELIVERY_OTP_SECRET=
