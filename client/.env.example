# Express API base URL (include /api/v1)
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Public origin of this site (used for Open Graph / canonical URLs)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Hostname of the image CDN (e.g. d1234.cloudfront.net) so next/image can optimise product photos
NEXT_PUBLIC_IMAGE_HOST=

# Supabase — anon key is public by design; never put the service_role key here
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Razorpay publishable key id (safe for the browser). The secret lives only on the server.
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx

# Footer / contact page. Leave any of these empty and that item is simply not shown (no placeholder links).
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_SUPPORT_PHONE=
NEXT_PUBLIC_SUPPORT_HOURS=
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_FACEBOOK=
NEXT_PUBLIC_SOCIAL_X=
NEXT_PUBLIC_SOCIAL_YOUTUBE=

# ── Security headers (read at BUILD time) ──
# A Content-Security-Policy is only sent for production builds whose NEXT_PUBLIC_SITE_URL is https.
# enforce (default) | report-only (log violations, block nothing) | off
CSP_MODE=enforce
# Optional https endpoint that receives CSP violation reports.
CSP_REPORT_URI=
